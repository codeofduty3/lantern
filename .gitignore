# Local demo/recording scripts (personal aids, not part of the deliverable)
docs/video_script*.md

# Generated project data and outputs
# Data dirs are ignored per-directory in data/.gitignore (DVC-maintained).
# Do NOT ignore data/ wholesale or via data/* + !data/*.dvc negation:
# DVC's internal gitignore engine mishandles the negation and then silently
# skips the .dvc pointer files during bulk pull/push/list, so a fresh
# clone's `dvc pull` never materializes data/ground_truth or data/managed.
# reports/ is Git-tracked: its only DVC outputs (metrics.json, plots/drift.png)
# are declared cache: false in dvc.yaml, i.e. versioned by Git on purpose.

# OCR calibration drafts: keep the notes and README, ignore the copied text dumps
reports/ocr_calibration_drafts/*.txt

# DVC / caching leftovers
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Vercel CLI link + generated env (contains a VERCEL_OIDC_TOKEN - never commit)
.vercel/
.env.local

# Optional: large model/cache directories if used locally
models/
weights/
checkpoints/
tests/fixtures/sources/
repro.log
.vercel
