# Python virtual environments and dependency artifacts
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# Local environment / editor files
.DS_Store
.vscode/
.idea/

# Generated project data and outputs
# Keep the source repo clean; these are produced by the pipeline.
# data stays ignored via data/* plus the DVC-maintained data/.gitignore;
# .dvc pointer files must reach Git (Part 8), so they are re-included.
# reports/ is Git-tracked: its only DVC outputs (metrics.json, plots/drift.png)
# are declared cache: false in dvc.yaml, i.e. versioned by Git on purpose.
data/*
!data/*.dvc
!data/.gitignore

# OCR calibration drafts: keep the notes and README, ignore the copied text dumps
reports/ocr_calibration_drafts/*.txt

# DVC / caching leftovers
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# Optional: large model/cache directories if used locally
models/
weights/
checkpoints/
